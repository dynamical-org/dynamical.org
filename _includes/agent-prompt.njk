{#
  A prompt the reader hands to an AI assistant, with a one-click copy. The text
  sits in a readonly textarea so it selects and copies as one unit and is
  reachable without JavaScript; the button and status are the enhancement
  (public/agent-prompt.mjs). Styles: .agent-prompt in main.css. Prompt texts:
  lib/agent-prompts.js. The "onboard your agent" button is agent-setup-pill.njk.

  {% from "agent-prompt.njk" import agentPrompt %}
  {{ agentPrompt(text, "Prompt for …", id, rows) }}
#}
{% macro agentPrompt(text, label, id, rows) %}
<div class="agent-prompt"{% if id %} data-prompt="{{ id }}"{% endif %}>
  <textarea readonly rows="{{ rows or 6 }}" aria-label="{{ label }}">{{ text }}</textarea>
  <button type="button">copy to clipboard</button>
  <span role="status"></span>
</div>
<script type="module" src="/agent-prompt.mjs?v={{ "public/agent-prompt.mjs" | fileHash }}"></script>
{% endmacro %}

{% macro collectionPromptViews(prompts, id) %}
<div class="prompt-views">
  <div class="prompt-view-tabs" role="tablist" aria-label="Prompt view">
    <button type="button" role="tab" id="{{ id }}-start-tab" aria-controls="{{ id }}-start" aria-selected="true">Start</button>
    {% if prompts.example %}<button type="button" role="tab" id="{{ id }}-example-tab" aria-controls="{{ id }}-example" aria-selected="false" tabindex="-1">Example</button>{% endif %}
  </div>
  <div class="prompt-view-panel" role="tabpanel" id="{{ id }}-start" aria-labelledby="{{ id }}-start-tab">
    {{ agentPrompt(prompts.start, "Start prompt for a coding agent", "dataset-start") }}
  </div>
  {% if prompts.example %}
    <div class="prompt-view-panel" role="tabpanel" id="{{ id }}-example" aria-labelledby="{{ id }}-example-tab" hidden>
      {{ agentPrompt(prompts.example, "Example prompt for a coding agent", "dataset-example") }}
    </div>
  {% endif %}
</div>
{% endmacro %}
