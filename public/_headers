# Cloudflare Pages merges matching rules, so narrower rules detach the broader
# Cache-Control value before setting their own.
/*.mjs
  Cache-Control: public, max-age=14400, must-revalidate

/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/vendor/preact-htm.mjs
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
