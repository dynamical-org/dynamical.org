# The vendored libraries are versioned in their file names, so an upgrade is a
# new URL and the old one can be cached for as long as a browser likes. Nothing
# else gets a long lifetime: the shim beside them keeps its name and changes
# on every upgrade, and page modules import it and their helpers by bare path,
# which no query string can reach, so all of those are served revalidated on
# every load (Pages' default). The HTML references stylesheets and page
# scripts with a content hash in the query string (the `fileHash` filter), so
# a deploy is consistent end to end.
/vendor/preact-10.29.8.mjs
  Cache-Control: public, max-age=31536000, immutable

/vendor/preact-hooks-10.29.8.mjs
  Cache-Control: public, max-age=31536000, immutable

/vendor/htm-3.1.1.mjs
  Cache-Control: public, max-age=31536000, immutable
