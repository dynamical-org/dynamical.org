      <div class="dim">Variables, dimensions, extent, license</div>
    </li>
    <li>
      <a href="#list-forecast-runs"><code>GET /v1/forecasts/runs</code></a>
      <div class="dim">Initialization times present in the current snapshot</div>
    </li>
    <li>
      <a href="#query-forecasts"><code>POST /v1/forecasts</code></a>
      <div class="dim">Batch point forecast time series</div>
    </li>
