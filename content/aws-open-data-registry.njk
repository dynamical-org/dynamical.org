---
pagination:
  data: catalog.models 
  alias: model
  size: 1
permalink: 'aws/dynamical-{{model.id}}.yaml'
---
{%- set entries = [] -%}
{%- for dataset in model.datasets -%}
  {%- if dataset.notebooks.length -%}
    {%- set _ = entries.push(dataset) -%}
  {%- endif -%}
{%- endfor -%}
{%- set bucket = "dynamical-" ~ model.id -%}
{#- The registry renders Description as markdown, not HTML: 1176 of 1177 dataset
    entries use markdown, and an AWS maintainer hand-converted our HTML back
    (awslabs/open-data-registry@78a7166, "dynamical markdown fix"). Emit the
    house style — blank-line separated blocks, `- [Title](url) - description`
    rows — so regenerated YAML matches what's already upstream. -#}
Name: {{model.name}} - dynamical.org Icechunk Zarr
Description: |
    {{ model.description | safe | trim }}

    These datasets have been translated to cloud-optimized Icechunk Zarr format by [dynamical.org](https://dynamical.org).
{% for entry in entries %}
    - [{{ entry.title }}](https://dynamical.org/catalog/{{ entry.id | slugify }}/) - {{ entry.description | safe }}
{%- endfor %}
Documentation: https://dynamical.org/catalog/
Contact: feedback@dynamical.org
ManagedBy: "[dynamical.org](https://dynamical.org)"
UpdateFrequency: "{% for entry in entries %}{{entry.title}}: {{ entry.time_resolution }}{% if not loop.last %}; {% endif %}{% endfor %}"
Tags:
  - aws-pds
  - weather
  - atmosphere
  - meteorological
  - climate
  - forecast
  - zarr
License: "[CC BY 4.0](https://creativecommons.org/licenses/by/4.0/)"
Resources:
  - Description: {{model.name}} Icechunk Zarr data
    ARN: arn:aws:s3:::dynamical-{{model.id}}
    Region: us-west-2
    Type: S3 Bucket
    Explore:
      - "[Browse Bucket](https://{{bucket}}.s3.amazonaws.com/index.html)"
  - Description: Notifications for dataset updates
    ARN: arn:aws:sns:us-west-2:761136292730:{{bucket}}-object_created
    Region: us-west-2
    Type: SNS Topic
DataAtWork:
  Tutorials:
    {%- for entry in entries %}
      {%- for notebook in entry.notebooks %}
    - Title: "{{ entry.title }} — {{ notebook.title }}"
      URL: {{ notebook.githubUrl }}
      NotebookURL: {{ notebook.githubUrl }}
      AuthorName: dynamical.org
      AuthorURL: https://dynamical.org
      {%- endfor %}
    {%- endfor %}
ADXCategories:
  - Environmental Data
