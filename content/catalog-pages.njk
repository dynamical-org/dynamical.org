---
layout: base.njk
pagination:
  data: catalog.entries
  alias: entry
  size: 1
  addAllPagesToCollections: true
permalink: 'catalog/{{entry.id | slugify}}/'
eleventyComputed:
  title: '{{entry.title}}'
  description: '{{ entry.description_meta }}'
  keywords: '{{ entry.model_name }}, {{ entry.title }}, {{ entry.model_name }} zarr, {{ entry.model_name }} data, {% if entry.forecast_domain %}weather forecast data{% else %}weather analysis data, reanalysis{% endif %}, cloud-optimized weather data, analysis-ready, Xarray, Icechunk'
  socialTitle: '{{ entry.title }} — dynamical.org'
  socialDescription: '{{ entry.facts | join(" · ") }}'
  socialCardImage: '{{ entry.thumbnail }}'
  licenseName: '{{ entry.license_links[0].title }}'
  licenseUrl: '{{ entry.license_links[0].href }}'
---

{% from "tag-icon.njk" import tagIcon %}
{% from "agent-prompt.njk" import agentPrompt %}
<style>
  .content.catalog-item {
    font-size: 1.4rem;
  }
  /* Benefit tags: inline icon + label list. Icons inherit currentColor. */
  .cat-tags {
    margin-top: 0.3rem;
    color: var(--muted-text);
  }
  .cat-tags svg,
  .related-datasets svg {
    margin-right: 0.4em;
  }
  /* The ID row: the id and an icon that copies it (public/agent-prompt.mjs),
     kept to one line of the table's rhythm. width: 0 + min-width: 100% lets
     the other rows size the column, so a long id ellipsizes on a phone rather
     than widening the table. The copy icon turns to a check while copied, and
     the status is only for screen readers, except when a copy fails: then it
     shows, and the id unclips so it can be copied by hand. The button's padding
     widens its hit area and the negative margin keeps it out of the row
     height. */
  td .agent-prompt {
    display: flex;
    align-items: baseline;
    width: 0;
    min-width: 100%;
  }
  td .agent-prompt code {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  td .agent-prompt button {
    flex-shrink: 0;
    margin: -0.5rem 0 -0.5rem 0.2rem;
    padding: 0.5rem;
    color: var(--muted-text);
  }
  td .agent-prompt button:hover,
  td .agent-prompt button:focus-visible,
  td .agent-prompt[data-copy="copied"] button {
    color: var(--link-color);
  }
  td .agent-prompt svg + svg,
  td .agent-prompt[data-copy="copied"] svg:first-child {
    display: none;
  }
  td .agent-prompt[data-copy="copied"] svg + svg {
    display: inline;
  }
  td .agent-prompt[data-copy="failed"] {
    flex-wrap: wrap;
  }
  td .agent-prompt[data-copy="failed"] code {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  td .agent-prompt[data-copy="failed"] [role="status"] {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    clip: auto;
    white-space: normal;
    flex-basis: 100%;
    color: var(--muted-text);
  }
  .metadata-comment {
    font-size: 80%;
  }
  .metadata-comment td {
    padding-top: 0;
  }
  .metadata-comment span {
    background-color: rgb(250, 250, 250);
    color: rgb(45, 45, 45);
  }
  .variable-group {
    margin-top: 1rem;
  }
  .variable-group > summary {
    cursor: pointer;
    font-size: 1.1em;
  }
  .variable-group > summary > strong {
    margin-left: 0.5em;
  }

  /* Variables — dense table. Dimensions are stated once above (they're
     identical across a group's variables) rather than repeated per row. */
  .var-note,
  .var-dims-note {
    margin: 0 0 0.75rem;
    color: var(--muted-text);
    font-size: 1.25rem;
  }
  table.var-table {
    border-collapse: collapse;
    width: 100%;
    border: 1px solid var(--border-color);
  }
  .var-table th,
  .var-table td {
    text-align: left;
    padding: 0.5rem 1rem;
    vertical-align: baseline;
  }
  .var-table th {
    border-bottom: 1px solid var(--border-color);
  }
  .var-table tr:not(:last-child) td {
    border-bottom: 1px dotted var(--border-muted-color);
  }
  .var-table .var-units {
    text-align: right;
    white-space: nowrap;
    color: var(--muted-text);
  }
  .var-name {
    font-weight: 700;
    display: block;
  }
  .var-long {
    display: block;
  }
  .var-src {
    color: var(--muted-text);
  }
  .var-desc {
    display: block;
    margin-top: 0.15rem;
    color: var(--muted-text);
    font-size: 1.25rem;
  }
  /* The unsharded chunk table has only two columns, so let it shrink to its
     content rather than stretching to the shared .data min-width. Sharded
     chunk tables (three columns) keep the wider default. */
  .detail-prose table.data:has(thead th:nth-child(2):last-child) {
    min-width: 0;
  }

  /* Open-snippet variants (dynamical-catalog vs pystac + icechunk) live in the
     code frame: tabs top-left, the dynamical.org mark top-right, and the
     example title in a status bar beneath the code. Colors are the frame's
     fixed dark palette (see .frame/.frameHeader in main.css) — the widget is
     always dark regardless of page theme. The frame is a query container so the
     mark can drop from wordmark to icon before it would crowd the tabs. */
  .frame {
    container-type: inline-size;
  }
  .codeTabList {
    display: flex;
    height: 100%;
    flex-shrink: 0;
  }
  .codeTab {
    appearance: none;
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 12px;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: #898989;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .codeTab:hover {
    color: #fafafa;
  }
  .codeTab[aria-selected="true"] {
    color: #fafafa;
    border-bottom-color: #fafafa;
  }
  .codeTabPanel[hidden] {
    display: none;
  }
  /* The prompt tab: the shared .agent-prompt control (main.css) redrawn in the
     frame's palette, its text set like the code in the tabs beside it. */
  .frame .agent-prompt {
    padding: 1.5rem;
    background: var(--code-bg);
  }
  .frame .agent-prompt textarea {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--frame-code-text);
    font-size: 1.5rem;
    resize: none;
  }
  .frame .agent-prompt button {
    margin-top: 1rem;
    color: var(--frame-text);
  }
  .frame .agent-prompt [role="status"] {
    color: var(--frame-muted-text);
  }
  /* Brand mark, top-right. The hosted lockup carries ~13% empty space below its
     artwork; scaling the image past a clipped box crops that padding so the
     mark matches the icon's height and stays vertically centered (18 × 91.73/80
     ≈ 20.6). */
  .frameBrand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.8;
  }
  .frameBrand-wordmark {
    display: block;
    height: 18px;
    overflow: hidden;
  }
  .frameBrand-wordmark img {
    display: block;
    height: 20.6px;
  }
  .frameBrand-icon {
    display: none;
    height: 18px;
    width: auto;
  }
  .frameStatus {
    padding: 8px 16px;
    background: black;
    border-top: 1px solid #292929;
    color: #898989;
    font-size: 13px;
    line-height: 1.35;
  }
  /* When the frame gets narrow, drop the wordmark to the icon and tighten the
     header so the mark clears the three tabs. */
  @container (max-width: 640px) {
    .frameBrand-wordmark {
      display: none;
    }
    .frameBrand-icon {
      display: block;
    }
    .frameHeader {
      padding: 0 10px;
      gap: 8px;
    }
    .codeTab {
      padding: 0 9px;
    }
  }
  /* Three tabs outgrow a phone's frame: let them wrap onto a second row
     rather than be clipped by the frame's overflow, and give them the mark's
     room so the code tabs share the first row. */
  @container (max-width: 500px) {
    .frameHeader {
      height: auto;
    }
    .frameBrand-icon {
      display: none;
    }
    .codeTabList {
      flex-wrap: wrap;
      flex-shrink: 1;
    }
    .codeTab {
      height: 40px;
    }
  }
  /* data.dynamical.org sunset notice. The only <aside> on the site, so it needs
     no class. Amber is the site's warning color (the status page's degraded
     state); --link-color would have read as navigation, not as a deprecation. */
  aside {
    margin: 2rem 0;
    padding: 1rem 1.2rem;
    border-left: 4px solid var(--pill-degraded-bg);
    border-radius: var(--radius-sm);
    background: var(--surface-muted);
  }
</style>
<script type="application/ld+json">{{ entry.jsonld | dump | safe }}</script>
{% macro variableTable(variables, groupName) %}
  {%- set commonDims = variables[0].dimension_names | join(' × ') -%}
  {% if groupName %}
    <p class="var-note">These variables live in the <code>{{ groupName }}</code> Zarr group (e.g. pass <code>group="{{ groupName }}"</code> to <code>dynamical_catalog.open()</code> or <code>xr.open_zarr()</code>).</p>
  {% endif %}
  <p class="var-dims-note">Dimensions: <code>{{ commonDims }}</code></p>
  <div class="table-container">
    <table class="var-table">
      <tr>
        <th>variable</th>
        <th class="var-units">units</th>
      </tr>
      {% for variable in variables %}
        {%- set varDims = variable.dimension_names | join(' × ') -%}
        <tr>
          <td>
            <span class="var-name">{{ variable.name }}</span>
            <span class="var-long">{{ variable.long_name }}{% if variable.short_name %} (<code class="var-src" title="Source (GRIB) short name, reference only, not an access key">{{ variable.short_name }}</code>){% endif %}</span>
            {%- if variable.comment or varDims != commonDims %}<span class="var-desc">{{ variable.comment }}{% if variable.comment and varDims != commonDims %} · {% endif %}{% if varDims != commonDims %}dimensions: {{ varDims }}{% endif %}</span>{% endif %}
          </td>
          <td class="var-units">{{ variable.units }}</td>
        </tr>
      {% endfor %}
    </table>
  </div>
{% endmacro %}
<div class="content catalog-item">
  {%- set model = catalog.models | find('id', entry.model_id) %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dynamical.org/" },
      { "@type": "ListItem", "position": 2, "name": "Catalog", "item": "https://dynamical.org/catalog/" },
      {% if model %}{ "@type": "ListItem", "position": 3, "name": {{ model.name | dump | safe }}, "item": "https://dynamical.org/catalog/models/{{ model.id | slugify }}/" },
      { "@type": "ListItem", "position": 4, "name": {{ entry.title | dump | safe }}, "item": "https://dynamical.org{{ page.url }}" }{% else %}{ "@type": "ListItem", "position": 3, "name": {{ entry.title | dump | safe }}, "item": "https://dynamical.org{{ page.url }}" }{% endif %}
    ]
  }
  </script>
  <div>
    <a href="/catalog">Catalog</a>
    {% if model %}&gt; <a href="/catalog/models/{{ model.id | slugify }}/">{{ model.name }}</a>{% endif %}
    &gt; {{ entry.title }}
  </div>
  {% if entry.id in ["noaa-gfs-forecast", "noaa-gfs-analysis", "noaa-gefs-forecast-35-day", "noaa-gefs-analysis", "noaa-hrrr-forecast-48-hour", "noaa-hrrr-analysis", "noaa-mrms-conus-analysis-hourly", "ecmwf-ifs-ens-forecast-15-day-0-25-degree", "ecmwf-aifs-single-forecast", "dwd-icon-eu-forecast-5-day"] %}
    <aside aria-label="data.dynamical.org migration">
      <strong><code>data.dynamical.org</code> access ends September 30, 2026.</strong>
      If you use a <code>data.dynamical.org</code> URL for this dataset,
      <a href="/migration-2026/">migrate to a supported access pattern</a>.
    </aside>
  {% endif %}
  <div style="margin: 3rem 0;">
    {% include "catalog-entry-status.njk" %}
    <h1>{{ entry.title }}</h1>
    <div class="cat-tags">{% for t in entry.access_tags %}{{ tagIcon(t.icon) }}{{ t.label }}{{ " · " if not loop.last }}{% endfor %}</div>
  </div>
  <table>
    <tr>
      <td>ID</td>
      <td>
        <div class="agent-prompt" data-prompt="dataset-id">
          <code>{{ entry.id }}</code>
          <button type="button" aria-label="Copy dataset ID" title="Copy dataset ID">{{ tagIcon("copy") }}{{ tagIcon("check") }}</button>
          <span role="status" class="visually-hidden"></span>
        </div>
        <script type="module" src="/agent-prompt.mjs?v={{ "public/agent-prompt.mjs" | fileHash }}"></script>
      </td>
    </tr>
    <tr>
      <td>Spatial domain</td>
      <td>{{ entry.spatial_domain }}</td>
    </tr>
    <tr>
      <td>Spatial resolution</td>
      <td>{{ entry.spatial_resolution }}</td>
    </tr>
    <tr>
      <td>Time domain</td>
      <td>{{ entry.time_domain }}</td>
    </tr>
    <tr>
      <td>Time resolution</td>
      <td>{{ entry.time_resolution }}</td>
    </tr>
    {% if entry.forecast_domain %}
      <tr>
        <td>Forecast domain</td>
        <td>{{ entry.forecast_domain }}</td>
      </tr>
      <tr>
        <td>Forecast resolution</td>
        <td>{{ entry.forecast_resolution }}</td>
      </tr>
    {% endif %}
  </table>
  <p>
    <span><a href="https://stac.dynamical.org/{{ entry.id }}/collection.json">STAC</a> (<a href="https://radiantearth.github.io/stac-browser/#/external/stac.dynamical.org/{{ entry.id }}/collection.json">browse</a>)</span>
    {%- set validationReport = validationReports.entries | find('datasetId', entry.id) %}
    {% if validationReport %}
      · <a href="/catalog/{{ entry.id }}/validation/">validation report</a>
    {% elif entry.validation_report_href %}
      · <a href="{{ entry.validation_report_href }}">validation report</a>
    {% endif %}
  </p>
  {% if model.description %}
    <p style="text-wrap: balance">{{ model.description | markdown | safe }}</p>
  {% endif %}
  <p style="text-wrap: balance">{{ entry.description_summary | markdown | safe }}</p>
  {% if model.datasets.length > 1 %}
    <h3>Related Datasets</h3>
    <ul class="related-datasets">
      {% for dataset in model.datasets %}
        {% if dataset.id != entry.id and dataset.status != "deprecated" %}
          <li>
            {% if dataset.status == 'live' or dataset.status == 'available' %}
              <a href="/catalog/{{ dataset.id | slugify }}">{{ dataset.title }}</a>
            {% else %}
              {{ dataset.title }} ({{ dataset.status }})
            {% endif %}
            - {% for t in dataset.access_tags %}{{ tagIcon(t.icon) }}{{ t.label }}{{ " · " if not loop.last }}{% endfor %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
  <h2>Examples</h2>
  <table>
    {% for notebook in entry.notebooks %}
      <tr>
        <td style="text-align: center"><img src="/assets/github-mark.svg" height="18"/>
        </td>
        <td>
          <a href="{{ notebook.githubUrl }}">{{ notebook.title }} (Github)</a>
        </td>
      </tr>
      <tr>
        <td style="text-align: center;"><img src="/assets/colab.svg" height="18"/>
        </td>
        <td>
          <a href="{{ notebook.colabUrl }}">{{ notebook.title }} (Colab)</a>
        </td>
      </tr>
    {% endfor %}
  </table>
  {#- The first example's frame carries a third tab beside the STAC code
      variants: the setup line plus a task on this product
      (lib/agent-prompts.js datasetPrompt), in place of the setup pill. -#}
  {% for example in entry.examples %}
    {%- set frameId = "example-" + loop.index %}
    {%- set withPrompt = loop.first %}
    {%- set variants = example.variants or [{ "label": "Python", "code": example.code }] %}
    <div class="frame">
      <div class="frameHeader">
        <div class="codeTabList" role="tablist" aria-label="{{ example.title }}">
          {% for variant in variants %}
            <button type="button" class="codeTab" role="tab" id="{{ frameId }}-tab-{{ loop.index }}" aria-controls="{{ frameId }}-panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ variant.label }}</button>
          {% endfor %}
          {% if withPrompt %}
            <button type="button" class="codeTab" role="tab" id="{{ frameId }}-tab-prompt" aria-controls="{{ frameId }}-panel-prompt" aria-selected="false" tabindex="-1">Example prompt</button>
          {% endif %}
        </div>
        <span class="frameBrand" aria-hidden="true">
          <span class="frameBrand-wordmark"><img src="https://assets.dynamical.org/identity/logo/lockup/lockup-white.svg" alt=""></span>
          <img class="frameBrand-icon" src="https://assets.dynamical.org/identity/logo/icon/icon-white.svg" alt="">
        </span>
      </div>
      {% for variant in variants %}
        <div class="codeTabPanel" role="tabpanel" id="{{ frameId }}-panel-{{ loop.index }}" aria-labelledby="{{ frameId }}-tab-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
          {{ variant.code | highlight('py', 'frameContent frameContentDesktop') | safe }}
          <div class="frameStatus">{{ entry.title }} · {{ example.title }}</div>
        </div>
      {% endfor %}
      {% if withPrompt %}
        <div class="codeTabPanel" role="tabpanel" id="{{ frameId }}-panel-prompt" aria-labelledby="{{ frameId }}-tab-prompt" hidden>
          {{ agentPrompt(agentPrompts.datasetPrompt(entry), "Example prompt for a coding agent", "dataset-example") }}
          <div class="frameStatus">{{ entry.title }} · Paste into your coding agent</div>
        </div>
      {% endif %}
    </div>
  {% endfor %}
  {% if not entry.examples.length %}
    {% include "agent-setup-pill.njk" %}
  {% endif %}
  {% explorer entry %}
  <h2>Dimensions</h2>
  <div class="table-container">
    <table class="data">
      <tr>
        <th/>
        <th class='right'>min</th>
        <th class='right'>max</th>
        <th class='right'>units</th>
      </tr>
      {% for dim in entry.dimensions %}
        <tr>
          <td>
            <strong>{{ dim.name }}</strong>
          </td>
          <td class='right'>{{ dim.statistics_approximate.min | roundIfNumber(3) }}</td>
          <td class='right'>{{ dim.statistics_approximate.max | roundIfNumber(3) if dim.statistics_approximate.max != null else "Present" }}</td>
          <td class='right'>{{ dim.units }}</td>
        </tr>
        <tr class="metadata-comment">
          <td colspan="4">
            <span></span>
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>
  <h2>Variables</h2>
  <p class="var-note">Access a variable by its name (the bold identifier, e.g. <code>ds["{{ entry.variables[0].name }}"]</code>).</p>
  {{ variableTable(entry.variables) }}
  {% for group in entry.variableGroups %}
    <details class="variable-group">
      <summary><strong>{{ group.name | replace("_", " ") | title }}</strong> ({{ group.variables.length }} variable{{ "s" if group.variables.length != 1 }})</summary>
      {{ variableTable(group.variables, group.name) }}
    </details>
  {% endfor %}
  <p class="metadata-comment">
    Don't see what you're looking for? Let us know at
    <a href="mailto:feedback@dynamical.org">feedback@dynamical.org</a>.
  </p>
  <h2>Details</h2>
    <h3>License</h3>
    {{ entry.license_md | markdown | safe }}

    <h3>Attribution and citation</h3>
    <p><i>{{ entry.attribution }}</i></p>
    <p>Or <i>{{ model.name }} from dynamical.org.</i></p>
    <p>
    <a href="https://doi.org/10.5281/zenodo.18777399"><img src="https://zenodo.org/badge/DOI/10.5281/zenodo.18777399.svg" alt="DOI"/></a>
    </p>
    <div class="detail-prose">{{ entry.description_details | markdown | safe }}</div>
    {%- set listing = listings[entry.id] %}
    {% if listing %}
      <h3>Additional details</h3>
      {%- set links = [] %}
      {%- if listing.earthmover %}{% set _ = links.push(["Earthmover Marketplace", listing.earthmover]) %}{% endif %}
      {%- if listing.source_coop %}{% set _ = links.push(["Source Cooperative", listing.source_coop]) %}{% endif %}
      {%- if listing.aws %}{% set _ = links.push(["AWS Open Data Registry", listing.aws]) %}{% endif %}
      <p>Also listed on {% for link in links %}{{ " · " if not loop.first }}<a href="{{ link[1] }}">{{ link[0] }}</a>{% endfor %}.</p>
    {% endif %}

<script>
  // Switch between tabs (the code variants and the example prompt) within each
  // code frame. Tabs live in the frame header, panels in the frame body, so
  // scope the lookup to .frame.
  document.querySelectorAll(".frame").forEach((frame) => {
    const buttons = [...frame.querySelectorAll(".codeTab")];
    const panels = [...frame.querySelectorAll(".codeTabPanel")];
    if (buttons.length === 0) return;
    const select = (i) => {
      buttons.forEach((b, j) => {
        const active = i === j;
        b.setAttribute("aria-selected", active ? "true" : "false");
        b.tabIndex = active ? 0 : -1;
        panels[j].hidden = !active;
      });
    };
    // Only the selected tab is in the Tab order; the arrow keys, Home and End
    // move between tabs (the WAI-ARIA tabs pattern), so the prompt tab and its
    // copy button are reachable without a mouse. Passing through a tab on the
    // way to another is not a choice, so it isn't tracked.
    frame.querySelector(".codeTabList").addEventListener("keydown", (event) => {
      const i = buttons.indexOf(document.activeElement);
      const n = buttons.length;
      const next = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[event.key];
      if (i < 0 || next === undefined) return;
      event.preventDefault();
      buttons[next].focus();
      select(next);
    });
    buttons.forEach((button, i) => {
      button.addEventListener("click", () => {
        select(i);
        // The prompt tab is not an access path; copying from it is tracked on
        // its own (agent_prompt_copied, public/agent-prompt.mjs).
        if (panels[i].querySelector(".agent-prompt")) return;
        // Which access path people reach for per dataset — the dynamical-catalog
        // client versus assembling pystac + icechunk by hand. Tells us where the
        // documentation and library effort is actually being spent.
        track("snippet_variant_selected", {
          // `dump` emits a JSON string literal, so an id containing a quote or an
          // ampersand can't break out of the script or arrive HTML-escaped.
          dataset: {{ entry.id | dump | safe }},
          variant: button.textContent.trim(),
        });
      });
    });
  });
</script>
</div>
